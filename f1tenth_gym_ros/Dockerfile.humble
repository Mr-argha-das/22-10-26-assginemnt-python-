# ROS 2 Humble native container for F1TENTH Gym ROS 2 Bridge (Berlin Map ready)
# Eliminates ROS 2 Foxy <-> Humble cross-distro FastDDS incompatibility
FROM ros:humble-ros-base

SHELL ["/bin/bash", "-c"]

RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
      git \
      python3-pip \
      python3-colcon-common-extensions \
      libeigen3-dev \
      libgl1 \
      ros-humble-rviz2 \
      ros-humble-xacro \
      ros-humble-robot-state-publisher \
      ros-humble-nav2-map-server \
      ros-humble-nav2-lifecycle-manager \
      ros-humble-ackermann-msgs \
      ros-humble-tf-transformations && \
    rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
      "numpy>=1.21.0,<2.0.0" \
      scipy \
      numba \
      Pillow \
      PyYAML \
      transforms3d \
      "gym==0.19.0" \
      "pyglet<1.5" \
      pyopengl

RUN git clone --depth 1 https://github.com/f1tenth/f1tenth_gym /opt/f1tenth_gym && \
    pip3 install --no-deps -e /opt/f1tenth_gym

WORKDIR /sim_ws
COPY . /sim_ws/src/f1tenth_gym_ros
RUN source /opt/ros/humble/setup.bash && colcon build

ENTRYPOINT ["/bin/bash"]
